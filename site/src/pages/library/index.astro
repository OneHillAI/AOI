---
import AppShell from '../../layouts/AppShell.astro';
import { getAllEntries, getFamilies } from '../../lib/entries';

const all = getAllEntries();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const models = all.filter((r) => r.type === 'model');
const providers = all.filter((r) => r.type === 'provider');
const crumbs = [{ label: 'Library' }];

// Region buckets for the Region facet and the row meta line.
const regionOf = (code) => {
  const c = String(code || '').toUpperCase();
  if (['US', 'USA', 'UNITED STATES'].includes(c)) return 'US';
  if (['CN', 'CHINA'].includes(c)) return 'China';
  const eu = ['FR', 'DE', 'NL', 'SE', 'ES', 'IT', 'FI', 'IE', 'BE', 'DK', 'PL', 'AT', 'EU',
    'FRANCE', 'GERMANY', 'NETHERLANDS', 'SWEDEN', 'SPAIN', 'ITALY', 'FINLAND', 'IRELAND', 'EUROPE'];
  if (eu.includes(c)) return 'EU';
  return c ? 'Other' : '';
};
const ORDER = ['full', 'substantial', 'partial', 'limited', 'none'];
const rank = (lvl) => {
  const i = ORDER.indexOf(lvl);
  return i < 0 ? ORDER.length : i;
};

// Facet option lists, derived from the data actually present.
const opennessOpts = [...new Set(models.map((r) => r.opennessTier).filter(Boolean))]
  .sort((a, b) => a.localeCompare(b));
const ownershipOpts = [...new Set(all.map((r) => r.ownership.level))].sort((a, b) => rank(a) - rank(b));
const regionOpts = [...new Set(all.map((r) => regionOf(r.regionCode)).filter(Boolean))]
  .sort((a, b) => ['US', 'EU', 'China', 'Other'].indexOf(a) - ['US', 'EU', 'China', 'Other'].indexOf(b));
const titleCase = (s) => s.replace(/_/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());

const row = (r) => {
  const region = regionOf(r.regionCode);
  const meta = r.type === 'model'
    ? [r.publisher, r.regionCode].filter(Boolean).join(' · ')
    : [r.regionCode].filter(Boolean).join(' · ');
  return { r, region, meta };
};
// The showcase groups model releases under their `family` relation (families ordered by
// their strongest release, releases within a family by score). Providers stay a flat list.
const families = getFamilies();
const providerRows = providers.map(row);
---
<AppShell title="Library - AI Ownership Index" crumbs={crumbs} browseActive="Library" reviewed={`${all.length} entries`} canvas="ledger">
  <nav slot="sidebar" class="navgroup" aria-label="Filter">
    <div class="lbl">Filter</div>
    <a class="on" data-seg-side="all" href="#">All entries <span class="pct">{all.length}</span></a>
    <a data-seg-side="model" href="#">Models <span class="pct">{models.length}</span></a>
    <a data-seg-side="provider" href="#">Providers <span class="pct">{providers.length}</span></a>
  </nav>

  <div class="lead">
    <h1>Open Models &amp; Providers, graded on ownership.</h1>
    <p>Each entry carries an <b>ownership level</b>, a plain read of whether you can restrict it, keep your data, and leave. Filter to what you're deciding, then open the full sheet.</p>
  </div>

  <div class="controls">
    <div class="seg" role="tablist" aria-label="Type">
      <button class="on" data-seg="all" type="button">All <b>{all.length}</b></button>
      <button data-seg="model" type="button">Models <b>{models.length}</b></button>
      <button data-seg="provider" type="button">Providers <b>{providers.length}</b></button>
    </div>
    <select class="facet" id="fOpenness" aria-label="Openness">
      <option value="">Openness: any</option>
      {opennessOpts.map((o) => <option value={o}>{titleCase(o)}</option>)}
    </select>
    <select class="facet" id="fOwnership" aria-label="Ownership">
      <option value="">Ownership: any</option>
      {ownershipOpts.map((o) => <option value={o}>{titleCase(o)}</option>)}
    </select>
    <select class="facet" id="fRegion" aria-label="Region">
      <option value="">Region: any</option>
      {regionOpts.map((o) => <option value={o}>{o}</option>)}
    </select>
    <span class="spacer"></span>
    <span class="count"><b id="count">{all.length}</b> entries</span>
    <select class="facet" id="fSort" aria-label="Sort">
      <option value="own">Sort: Ownership, high to low</option>
      <option value="score">AOI score, high to low</option>
      <option value="name">Name, A to Z</option>
      <option value="docs">Documentation, high to low</option>
    </select>
  </div>
  <div class="chips" id="chips"></div>

  <div class="ledger">
    <div class="ledger__head"><span>Grade</span><span>Entry</span><span>Openness</span><span>Ownership</span><span>Docs</span></div>

    {families.map((fam) => (
      <Fragment>
        <div class="grouplabel grouplabel--fam" data-group={`fam-${fam.id}`} data-fam="model">
          <span class="fam-kick">Family</span>
          <span class="fam-name">{fam.name}</span>
          <span class="fam-n">{fam.entries.length} {fam.entries.length === 1 ? 'release' : 'releases'}</span>
        </div>
        <div data-groupbody={`fam-${fam.id}`}>
          {fam.entries.map(row).map(({ r, region, meta }) => (
            <a class={`entry own-${r.ownership.level}`} href={`${base}/library/${r.dir}/${r.id}/`}
               data-type="model" data-openness={r.opennessTier} data-ownership={r.ownership.level}
               data-region={region} data-name={r.title.toLowerCase()} data-score={r.score} data-docs={r.docsGauge} data-rank={rank(r.ownership.level)}>
              <span class="entry__grade"><span class="entry__letter">{r.grade}</span><span class="entry__score">{r.score}</span></span>
              <span class="entry__nameblock"><span class="entry__name">{r.title}</span><span class="entry__meta">{meta}</span></span>
              <span class="entry__open">{r.opennessTier}<small>{r.licence}</small></span>
              <span class="entry__own"><span>{r.ownership.level}</span></span>
              <span class="gauge"><span class="gauge__track"><span class="gauge__fill" style={`width:${r.docsGauge}%`}></span></span><span class="gauge__pct">{r.docsGauge}%</span></span>
            </a>
          ))}
        </div>
      </Fragment>
    ))}

    <div class="grouplabel" data-group="provider">Inference providers</div>
    <div data-groupbody="provider">
      {providerRows.map(({ r, region, meta }) => (
        <a class={`entry own-${r.ownership.level}`} href={`${base}/library/${r.dir}/${r.id}/`}
           data-type="provider" data-openness="" data-ownership={r.ownership.level}
           data-region={region} data-name={r.title.toLowerCase()} data-score={r.score} data-docs={r.docsGauge} data-rank={rank(r.ownership.level)}>
          <span class="entry__grade"><span class="entry__letter">{r.grade}</span><span class="entry__score">{r.score}</span></span>
          <span class="entry__nameblock"><span class="entry__name">{r.title}</span><span class="entry__meta">{meta}</span></span>
          <span class="entry__open">serves OSS<small>inference</small></span>
          <span class="entry__own"><span>{r.ownership.level}</span></span>
          <span class="gauge"><span class="gauge__track"><span class="gauge__fill" style={`width:${r.docsGauge}%`}></span></span><span class="gauge__pct">{r.docsGauge}%</span></span>
        </a>
      ))}
    </div>

    <div class="empty" id="empty"><h3>No entries match.</h3><p>Try removing a filter.</p><button type="button" id="clearAll2">Clear filters</button></div>
  </div>

  <div class="legend">
    <b>How to read a row.</b> The gold grade is the ownership verdict at a glance. Openness is what you receive (weights, licence). Ownership is the plain level. Docs is how complete our four-domain write-up is.
    <dl>
      <dt>Ownership level</dt><dd>full to none, floor-weighted from the four ownership factors.</dd>
      <dt>Substantial / Partial / Limited</dt><dd>how much of the work you run stays yours.</dd>
      <dt>Openness tier</dt><dd>fully open, open weights, or restricted.</dd>
      <dt>Docs</dt><dd>completeness across Assess, Implement, Use and Support.</dd>
    </dl>
  </div>

  <script is:inline>
    (function () {
      var state = { seg: 'all', openness: '', ownership: '', region: '', sort: 'own' };
      var count = document.getElementById('count');
      var empty = document.getElementById('empty');
      var chips = document.getElementById('chips');
      var segBtns = document.querySelectorAll('[data-seg]');
      var sideBtns = document.querySelectorAll('[data-seg-side]');
      var fOpen = document.getElementById('fOpenness');
      var fOwn = document.getElementById('fOwnership');
      var fReg = document.getElementById('fRegion');
      var fSort = document.getElementById('fSort');
      var FACETLABEL = { openness: 'Openness', ownership: 'Ownership', region: 'Region' };

      function titleCase(s) { return s.replace(/_/g, ' ').replace(/\b\w/g, function (c) { return c.toUpperCase(); }); }

      function sortRows() {
        document.querySelectorAll('[data-groupbody]').forEach(function (body) {
          var rows = Array.prototype.slice.call(body.querySelectorAll('.entry'));
          rows.sort(function (a, b) {
            if (state.sort === 'name') return a.dataset.name.localeCompare(b.dataset.name);
            if (state.sort === 'score') return (+b.dataset.score) - (+a.dataset.score);
            if (state.sort === 'docs') return (+b.dataset.docs) - (+a.dataset.docs);
            // ownership high to low, then score
            var r = (+a.dataset.rank) - (+b.dataset.rank);
            return r !== 0 ? r : (+b.dataset.score) - (+a.dataset.score);
          });
          rows.forEach(function (row) { body.appendChild(row); });
        });
      }

      function apply() {
        var shown = 0;
        document.querySelectorAll('.entry').forEach(function (row) {
          var ok = (state.seg === 'all' || row.dataset.type === state.seg)
            && (!state.openness || row.dataset.openness === state.openness)
            && (!state.ownership || row.dataset.ownership === state.ownership)
            && (!state.region || row.dataset.region === state.region);
          row.style.display = ok ? '' : 'none';
          if (ok) shown++;
        });
        // Hide a group label + body when it has no visible rows.
        document.querySelectorAll('[data-groupbody]').forEach(function (body) {
          var type = body.dataset.groupbody;
          var any = body.querySelector('.entry:not([style*="display: none"])');
          var visible = Array.prototype.some.call(body.querySelectorAll('.entry'), function (r) { return r.style.display !== 'none'; });
          var label = document.querySelector('.grouplabel[data-group="' + type + '"]');
          if (label) label.style.display = visible ? '' : 'none';
          body.style.display = visible ? '' : 'none';
        });
        if (count) count.textContent = shown;
        if (empty) empty.style.display = shown ? 'none' : 'block';
        segBtns.forEach(function (b) { b.classList.toggle('on', b.dataset.seg === state.seg); });
        sideBtns.forEach(function (b) { b.classList.toggle('on', b.dataset.segSide === state.seg); });
        renderChips();
      }

      function renderChips() {
        var active = [];
        if (state.seg !== 'all') active.push({ key: 'seg', label: state.seg === 'model' ? 'Models' : 'Providers' });
        ['openness', 'ownership', 'region'].forEach(function (k) {
          if (state[k]) active.push({ key: k, label: FACETLABEL[k] + ': ' + titleCase(state[k]) });
        });
        chips.innerHTML = '';
        if (!active.length) return;
        active.forEach(function (a) {
          var chip = document.createElement('span');
          chip.className = 'chip';
          chip.textContent = a.label + ' ';
          var x = document.createElement('button');
          x.type = 'button'; x.setAttribute('aria-label', 'Remove'); x.textContent = '×';
          x.addEventListener('click', function () { clearOne(a.key); });
          chip.appendChild(x);
          chips.appendChild(chip);
        });
        var clear = document.createElement('button');
        clear.className = 'clear'; clear.type = 'button'; clear.textContent = 'Clear all';
        clear.addEventListener('click', clearAll);
        chips.appendChild(clear);
      }

      function clearOne(key) {
        if (key === 'seg') state.seg = 'all';
        else { state[key] = ''; syncSelects(); }
        apply();
      }
      function clearAll() {
        state.seg = 'all'; state.openness = ''; state.ownership = ''; state.region = '';
        syncSelects(); apply();
      }
      function syncSelects() {
        if (fOpen) fOpen.value = state.openness;
        if (fOwn) fOwn.value = state.ownership;
        if (fReg) fReg.value = state.region;
      }

      segBtns.forEach(function (b) { b.addEventListener('click', function () { state.seg = b.dataset.seg; apply(); }); });
      sideBtns.forEach(function (b) { b.addEventListener('click', function (e) { e.preventDefault(); state.seg = b.dataset.segSide; apply(); }); });
      if (fOpen) fOpen.addEventListener('change', function () { state.openness = fOpen.value; apply(); });
      if (fOwn) fOwn.addEventListener('change', function () { state.ownership = fOwn.value; apply(); });
      if (fReg) fReg.addEventListener('change', function () { state.region = fReg.value; apply(); });
      if (fSort) fSort.addEventListener('change', function () { state.sort = fSort.value; sortRows(); });
      var clearAll2 = document.getElementById('clearAll2');
      if (clearAll2) clearAll2.addEventListener('click', clearAll);

      sortRows();
      apply();
    })();
  </script>

  <style>
    /* The library groups model releases under their family. The family header overrides the
       flat section-label treatment: the family name reads as itself (cased, inked), preceded by
       a small gold kicker and followed by a muted release count, with a hairline separating groups. */
    .grouplabel--fam {
      display: flex;
      align-items: baseline;
      gap: .55rem;
      text-transform: none;
      letter-spacing: 0;
      color: var(--ink);
      font-size: 1rem;
      font-weight: 700;
      padding-top: 1.5rem;
      border-top: 1px solid var(--line-soft);
    }
    /* No divider or extra gap above the very first family group. */
    .ledger__head + .grouplabel--fam { border-top: 0; padding-top: .6rem; }
    .fam-kick {
      align-self: center;
      font-size: .52rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .16em;
      color: var(--gold);
    }
    .fam-name { color: var(--ink); }
    .fam-n {
      margin-left: auto;
      font-family: var(--mono);
      font-size: .66rem;
      font-weight: 500;
      letter-spacing: .02em;
      text-transform: none;
      color: var(--muted);
    }
  </style>
</AppShell>
